# Скопируйте в .env — docker compose подхватит его автоматически.

# ---------- Фронтенд ----------
# Распознавание речи: browser (Web Speech API браузера) или server (Yandex SpeechKit через бэкенд)
VITE_STT_ENGINE=browser
# false — фронт работает с настоящим бэкендом (вход через Яндекс, GigaChat, календарь)
VITE_USE_MOCKS=false

# ---------- Бэкенд ----------
# Ключ для шифрования токенов и cookie. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_TIMEZONE=Europe/Moscow
FRONTEND_URL=http://localhost:5173
# true, если сайт открывается по HTTPS
COOKIE_SECURE=false

# Яндекс ID — приложение на https://oauth.yandex.ru/client/new
#   Платформа «Веб-сервисы», Redirect URI: http://localhost:5173/api/auth/yandex/callback
#   Права: Яндекс ID (логин, имя, почта, аватар) и Календарь (чтение и запись по CalDAV)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
# Пусто — запросить все права, отмеченные в приложении
YANDEX_OAUTH_SCOPE=
# Имя отдельного календаря, который ассистент создаёт в Яндекс Календаре
YANDEX_CALENDAR_NAME=Voices

# GigaChat — https://developers.sber.ru/studio → проект GigaChat API → «Ключ авторизации»
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Новый адрес API из документации: https://api.giga.chat/v1
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
# false — не проверять TLS-сертификат (только для разработки, если не скачался сертификат НУЦ Минцифры)
GIGACHAT_VERIFY_SSL=true

# Yandex Cloud SpeechKit (для VITE_STT_ENGINE=server): API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
