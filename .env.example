# Скопируйте в .env — docker compose подхватит его автоматически.

# ---------- Фронтенд ----------
# Распознавание речи: browser (Web Speech API браузера) или server (Yandex SpeechKit через бэкенд)
VITE_STT_ENGINE=browser
# true — фронт работает без бэкенда, на моках
VITE_USE_MOCKS=false

# ---------- Бэкенд ----------
# Ключ для шифрования токенов и cookie. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_TIMEZONE=Europe/Moscow
FRONTEND_URL=http://localhost:5173
# true, если сайт открывается по HTTPS
COOKIE_SECURE=false

# Яндекс ID — приложение на https://oauth.yandex.ru/client/new
#   Платформа «Веб-сервисы», Redirect URI: http://localhost:5173/api/auth/yandex/callback
#   Права: «Доступ к логину, имени», «Доступ к адресу почты» и Календарь — полный доступ (calendar:all)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5173/api/auth/yandex/callback

# Google — https://console.cloud.google.com → APIs & Services
#   1) Включите Google Calendar API  2) OAuth consent screen (External, добавьте себя в Test users)
#   3) Credentials → OAuth client ID → Web application,
#      Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Имя отдельного календаря ассистента (Google его использует; Яндекс называет календарь по имени приложения)
CALENDAR_NAME=Voices

# GigaChat — https://developers.sber.ru/studio → проект GigaChat API → «Ключ авторизации»
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Новый адрес API из документации: https://api.giga.chat/v1
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
# false — не проверять TLS-сертификат (только для разработки, если не скачался сертификат НУЦ Минцифры)
GIGACHAT_VERIFY_SSL=true

# Синтез речи для режима беседы: GigaChat/SaluteSpeech через Cloud.ru Foundation Models
#   Ключ: https://console.cloud.ru → Foundation Models → API-ключи. Без ключа ассистент говорит голосом браузера.
CLOUDRU_API_KEY=
# Голоса: Mer-Operator, Kaz-Lifelike, Tsb-Freespeech, Gli-Operator, Gli-Freespeech, Bab-Debate, Bab-Energetic, Bab-Freespeech, Tsb-Hesitating
TTS_VOICE=Mer-Operator
TTS_SPEED=1.0

# Yandex Cloud SpeechKit (для VITE_STT_ENGINE=server): API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
