# Прод: скопируйте в .env рядом с compose.prod.yaml.
#   docker compose -f compose.prod.yaml pull && docker compose -f compose.prod.yaml up -d

# ---------- Инфраструктура ----------
# Пароль БД — без спецсимволов (@ : / # ? %), он подставляется в URL подключения. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=
# Тег образов (latest, sha-xxxx или 1.2.3) и их префикс, если форк
IMAGE_TAG=latest
# IMAGE_PREFIX=ghcr.io/crepythecreator/voices-assistant
# Порты на хосте: 80 перенаправляет на 443
HTTP_PORT=80
HTTPS_PORT=443
# Домен сайта — по нему nginx ищет сертификат /etc/letsencrypt/live/<DOMAIN>/
DOMAIN=example.com
# Где на хосте лежат сертификаты certbot и папка для проверки домена (значения по умолчанию)
# LETSENCRYPT_DIR=/etc/letsencrypt
# ACME_WEBROOT=/var/www/certbot

# ---------- Бэкенд ----------
# Ключ для шифрования токенов и cookie. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Не меняйте после запуска: сохранённые токены Яндекса и Google перестанут расшифровываться
APP_SECRET_KEY=
APP_TIMEZONE=Europe/Moscow
# Адрес сайта по HTTPS, без слэша в конце
FRONTEND_URL=https://example.com
COOKIE_SECURE=true

# Redirect URI в кабинетах провайдеров должны совпадать с этими значениями
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/api/auth/yandex/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

CALENDAR_NAME=Voices

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_SSL=true

# Синтез речи и серверное распознавание (GigaASR)
CLOUDRU_API_KEY=
TTS_VOICE=Mer-Operator
TTS_SPEED=1.0
STT_PROVIDER=auto
STT_MODEL=GigaChat/GigaASR

# Запасное распознавание: Yandex SpeechKit
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
