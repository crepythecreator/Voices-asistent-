# Database
POSTGRES_PASSWORD=

# Docker images
IMAGE_TAG=latest

# Ports and HTTPS (Let's Encrypt)
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=example.com

# Backend
APP_SECRET_KEY=
APP_TIMEZONE=Europe/Moscow
FRONTEND_URL=https://example.com
COOKIE_SECURE=true

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/api/auth/yandex/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

# Calendar
CALENDAR_NAME=Voices

# GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_SSL=true

# Cloud.ru (TTS, GigaASR)
CLOUDRU_API_KEY=
TTS_VOICE=Mer-Operator
TTS_SPEED=1.0

# Speech-to-text
STT_PROVIDER=auto
STT_MODEL=GigaChat/GigaASR

# Yandex SpeechKit
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
